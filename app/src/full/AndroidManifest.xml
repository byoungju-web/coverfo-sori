<?xml version="1.0" encoding="utf-8"?>
<!-- APK용(full)만: 구글 플레이(store)용에는 넣지 않는다.
     · 설치된 모든 앱 이름에서 찾아 "○○ 앱 열어 줘"를 할 수 있게 (QUERY_ALL_PACKAGES)
     · v5.1: 카톡 자동 보내기(접근성 서비스)는 뺐다 — 웹에서 받아 설치하는 앱이 접근성을 쓰면
       Google Play 프로텍트가 설치를 막는다 (2026-10-28 실제로 '기기 보호를 위해 앱 차단됨'). 카톡은 1탭 보내기로 보낸다. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- v28 🎧 오디오·스트림 번역 (APK판만 · 구글 플레이판은 '화면 녹화' 서비스 신고가 따로 필요해서 넣지 않음)
         폰에서 나오는 다른 앱 소리(유튜브 등)를 받아 번역 — 포도랑 앱의 같은 기능을 옮겨 옴.
         coverfo.com 화면이 coverfosori://audio?from=&to=&tk= 로 엽니다. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <application>
        <activity
            android:name=".AudioActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/audioTitle"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="coverfosori" android:host="audio" />
            </intent-filter>
        </activity>
        <service
            android:name=".AudioCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>

</manifest>
