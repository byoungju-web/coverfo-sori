<?xml version="1.0" encoding="utf-8"?>
<!-- APK용(full)만: 구글 플레이(store)용에는 넣지 않는다.
     · 설치된 모든 앱 이름에서 찾아 "○○ 앱 열어 줘"를 할 수 있게 (QUERY_ALL_PACKAGES)
     · v5 카톡 자동 보내기 (접근성 서비스 — 이용자가 설정에서 직접 켰을 때만, 카카오톡 화면만) -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application>
        <service
            android:name=".KakaoAutoService"
            android:exported="false"
            android:label="@string/kakao_auto_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/kakao_auto" />
        </service>
    </application>
</manifest>
