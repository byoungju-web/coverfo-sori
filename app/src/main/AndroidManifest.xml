<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- v6 ☀️ 아침 브리핑: 폰을 다시 켜면 알림 알람을 다시 건다 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 카카오내비 설치 여부 확인 (안드로이드 11+ 앱 목록 보기 제한) -->
    <!-- v4 ② "카톡 켜 줘" 처럼 말로 열 수 있는 앱 (AppLauncher.KNOWN 과 같은 목록) + 기본 기능(카메라·전화·문자 등) -->
    <queries>
        <package android:name="com.locnall.KimGiSa" />
        <package android:name="com.kakao.talk" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.google.android.apps.youtube.music" />
        <package android:name="net.daum.android.map" />
        <package android:name="com.kakao.taxi" />
        <package android:name="com.kakaopay.app" />
        <package android:name="com.kakaobank.channel" />
        <package android:name="com.nhn.android.search" />
        <package android:name="com.nhn.android.nmap" />
        <package android:name="com.nhn.android.band" />
        <package android:name="com.naver.labs.translator" />
        <package android:name="com.google.android.apps.maps" />
        <package android:name="com.skt.tmap.ku" />
        <package android:name="com.coupang.mobile.eats" />
        <package android:name="com.coupang.mobile" />
        <package android:name="com.sampleapp" />
        <package android:name="com.fineapp.yogiyo" />
        <package android:name="com.towneers.www" />
        <package android:name="viva.republica.toss" />
        <package android:name="com.instagram.android" />
        <package android:name="com.facebook.katana" />
        <package android:name="com.zhiliaoapp.musically" />
        <package android:name="com.netflix.mediaclient" />
        <package android:name="com.iloen.melon" />
        <package android:name="com.ktmusic.geniemusic" />
        <package android:name="com.android.chrome" />
        <package android:name="com.sec.android.app.sbrowser" />
        <package android:name="com.google.android.gm" />
        <package android:name="com.elevenst" />
        <package android:name="com.ebay.kr.gmarket" />
        <package android:name="com.musinsa.store" />
        <package android:name="com.cultsotry.yanolja.nativeapp" />
        <package android:name="kr.goodchoice.abouthere" />
        <package android:name="com.korail.talk" />
        <intent><action android:name="android.media.action.STILL_IMAGE_CAMERA" /></intent>
        <intent><action android:name="android.intent.action.DIAL" /></intent>
        <intent><action android:name="android.intent.action.SHOW_ALARMS" /></intent>
        <intent><action android:name="android.settings.SETTINGS" /></intent>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.APP_MESSAGING" /></intent>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.APP_GALLERY" /></intent>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.APP_CALENDAR" /></intent>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.APP_CALCULATOR" /></intent>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.APP_CONTACTS" /></intent>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.APP_EMAIL" /></intent>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Google 로그인 후 크롬 창에서 앱으로 돌아오는 주소: coverfosori://login -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="coverfosori" android:host="login" />
            </intent-filter>
        </activity>

        <!-- v6 ☀️ 아침 브리핑 알림: 알람(앱 안에서만) · 폰 재시작/앱 업데이트 뒤 다시 걸기 -->
        <receiver android:name=".BriefReceiver" android:exported="false" />
        <receiver android:name=".BriefBootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".SoriService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>
</manifest>
